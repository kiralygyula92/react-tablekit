{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@kingtech/react-tablekit": ["../../packages/react-tablekit/src/index.ts"],
      "@kingtech/react-tablekit/core": ["../../packages/react-tablekit/src/core/index.ts"],
      "@kingtech/react-tablekit/meta": ["../../packages/react-tablekit/src/meta.ts"],
      "@kingtech/react-tablekit/locales/*": ["../../packages/react-tablekit/src/locales/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "content"]
}
