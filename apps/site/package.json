{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-api.mjs && tsc -p tsconfig.json && vite build",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @visual",
    "lighthouse": "lighthouse http://localhost:4173/ --only-categories=performance --preset=desktop --chrome-flags=\"--headless=new\" --quiet --output=json --output-path=stdout",
    "e2e:visual": "playwright test --project=visual"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.3",
    "react-tablekit": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lighthouse": "^13.4.1",
    "msw": "^2.15.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
