{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:data && vite",
    "build": "pnpm run build:data && tsc -p tsconfig.json && vite build && pnpm run prerender",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview --port 4183 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @visual",
    "lighthouse": "lighthouse http://localhost:4183/ --only-categories=performance --preset=desktop --chrome-flags=\"--headless=new\" --quiet --output=json --output-path=stdout",
    "e2e:visual": "playwright test --project=visual",
    "build:content": "node scripts/build-content.mjs",
    "build:data": "node scripts/build-api.mjs && node scripts/build-content.mjs && node scripts/build-machine-surface.mjs && node scripts/build-redirects.mjs",
    "build:machine": "node scripts/build-machine-surface.mjs",
    "prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:redirects": "node scripts/build-redirects.mjs",
    "conformance": "node scripts/conformance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0",
    "react-tablekit": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "github-slugger": "^2.0.0",
    "lighthouse": "^13.4.1",
    "msw": "^2.15.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.4.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
