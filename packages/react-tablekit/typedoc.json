{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/core/index.ts"],
  "tsconfig": "./tsconfig.json",
  "json": ".typedoc/api.json",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "readme": "none",
  "hideGenerator": true,
  "skipErrorChecking": true,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": ["Function", "Class", "Interface", "TypeAlias", "Variable", "Method"]
}
