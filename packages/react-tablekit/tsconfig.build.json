{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [],
    "noEmit": false,
    // tsup's d.ts bundler injects the deprecated `baseUrl`; TS 6 errors on it without this.
    "ignoreDeprecations": "6.0"
